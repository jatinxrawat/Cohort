{
  "headers": [
    {
      "source": "/ota/manifest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/uncut/:storyId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(whatsapp|facebookexternalhit|twitterbot|slackbot|linkedinbot|telegram|embedly|discordbot).*"
        }
      ],
      "destination": "/api/uncut?storyId=:storyId"
    },
    {
      "source": "/post/:postId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(whatsapp|facebookexternalhit|twitterbot|slackbot|linkedinbot|telegram|embedly|discordbot).*"
        }
      ],
      "destination": "/api/post?postId=:postId"
    },
    {
      "source": "/((?!api|ota|assets|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
